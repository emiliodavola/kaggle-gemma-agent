# Host-trial backend config. Copy to `.env`; git-ignored; NEVER commit secrets.
# Trial-only (meaningless for the offline submission). Process env wins.
# The WHOLE file is parsed: keep exactly one active definition per key.

# API key for the OpenAI-compatible backend. Required and non-empty; the runner
# aborts otherwise. Local servers ignore the value: use any dummy (e.g.
# sk-local-not-used). Cloud backends need the real key.
OPENAI_API_KEY=sk-replace-me

# Backend selector: picks the base URL from a code-side preset table.
# One of opencode (default) / dmr / lmstudio / llamacpp.
HARNESS_TRIAL_BACKEND=opencode

# Wire model id (`openai/<HARNESS_MODEL>`); use the exact id the backend serves.
# Each backend exposes its own id, so HARNESS_MODEL must match the selector.
HARNESS_MODEL=deepseek-v4.1-flash

# Optional: explicit base URL override. Wins over the selector preset; leave it
# commented to use the preset for HARNESS_TRIAL_BACKEND.
# OPENAI_BASE_URL=https://opencode.ai/zen/go/v1

# Optional: session id for the x-opencode-session header.
# HARNESS_TRIAL_SESSION=swegemma-host-trial
# Optional: comma-separated task ids; unset keeps fastapi_15661,fastapi_15588.
# HARNESS_TRIAL_TASKS=fastapi_15661,fastapi_15588
# Optional: supplemental wheel dir(s) merged into data/raw/wheels/ (os.pathsep
# separated); use it to stage a wheel the competition set omits (issue #39).
# HARNESS_TRIAL_WHEELS_EXTRA=data/raw/wheels-extra

# ---------------------------------------------------------------------------
# Backend presets (reference only). Set HARNESS_TRIAL_BACKEND to one of these
# instead of uncommenting a base URL; the presets live in code so no live key is
# ever repeated. Precedence: explicit OPENAI_BASE_URL > selector preset >
# `opencode` default. HARNESS_MODEL stays explicit and must match the backend.
# For every local preset the API key value is ignored: leave the active key as
# a non-empty dummy (sk-replace-me / sk-local-not-used both work).
# Before the eval the runner probes the backend once (tool-aware) and fails fast
# if it is unreachable or cannot do tool calling. See
# docs/host-trial-runbook.md section 6.1.
#
# selector    base URL                                   example HARNESS_MODEL
# opencode    https://opencode.ai/zen/go/v1              deepseek-v4.1-flash
# dmr         http://localhost:12434/engines/vllm/v1     huggingface.co/google/gemma-4-31b-it-qat-w4a16-ct:latest
# lmstudio    http://127.0.0.1:1234/v1                   <model id shown in the LM Studio UI>
# llamacpp    http://127.0.0.1:8080/v1                   <served model id>
# ---------------------------------------------------------------------------

# Docker Model Runner — the only local preset that loads the competition
# checkpoint `google/gemma-4-31B-it-qat-w4a16-ct` (safetensors, INT4 QAT).
# Enable Docker Desktop -> Settings -> AI -> host-side TCP on port 12434, then:
#   docker model run --detach hf.co/google/gemma-4-31B-it-qat-w4a16-ct
#   docker model list          # exact id for HARNESS_MODEL
# Confirm the id the OpenAI API expects:
#   curl -s http://localhost:12434/engines/vllm/v1/models
# From inside a container: http://model-runner.docker.internal/engines/vllm/v1

# LM Studio and llama.cpp are GGUF-only and cannot load the QAT safetensors
# checkpoint; they remain useful for a GGUF substitute. llama.cpp needs
# `--jinja` for OpenAI tool calling.
