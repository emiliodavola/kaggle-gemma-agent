# Host-trial backend config. Copy to `.env`; git-ignored; NEVER commit secrets.
# Trial-only (meaningless for the offline submission). Process env wins.
# The runner parses only the FIRST 20 LINES here: keep active keys near the top.

# API key for the OpenAI-compatible backend. Required, non-empty (locals ignore it).
OPENAI_API_KEY=sk-replace-me

# Base URL of the backend (the runner proxies to it and adds x-opencode-session).
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1

# Wire model id (`openai/<HARNESS_MODEL>`); use the exact id the backend serves.
HARNESS_MODEL=deepseek-v4.1-flash

# Optional: session id for the x-opencode-session header.
# HARNESS_TRIAL_SESSION=swegemma-host-trial
# Optional: comma-separated task ids; unset keeps fastapi_15661,fastapi_15588.
# HARNESS_TRIAL_TASKS=fastapi_15661,fastapi_15588

# Backend presets + notes are below line 20 (reference only). Copy a preset
# value into the ACTIVE keys above; do not uncomment below 20.

# ---------------------------------------------------------------------------
# Backend presets — pick ONE and set OPENAI_BASE_URL + HARNESS_MODEL above.
# Before the eval the runner probes the backend once (tool-aware) and fails fast
# if it is unreachable or cannot do tool calling. See
# docs/host-trial-runbook.md section 6.1.
# ---------------------------------------------------------------------------

# Docker Model Runner — the only local option that loads the competition
# checkpoint `google/gemma-4-31B-it-qat-w4a16-ct` (safetensors, INT4 QAT).
# Enable Docker Desktop -> Settings -> AI -> host-side TCP on port 12434, then:
#   docker model run --detach hf.co/google/gemma-4-31B-it-qat-w4a16-ct
#   docker model list          # exact id for HARNESS_MODEL
# OPENAI_BASE_URL=http://localhost:12434/engines/vllm/v1
# HARNESS_MODEL=huggingface.co/google/gemma-4-31b-it-qat-w4a16-ct:latest
# Confirm the id the OpenAI API expects:
#   curl -s http://localhost:12434/engines/vllm/v1/models
# From inside a container: http://model-runner.docker.internal/engines/vllm/v1

# LM Studio — GGUF only; cannot load the QAT safetensors checkpoint.
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# HARNESS_MODEL=<model id shown in the LM Studio UI>

# llama.cpp server — GGUF only; `--jinja` is required for OpenAI tool calling.
# OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# HARNESS_MODEL=<served model id>

# opencode.ai (default cloud backend).
# OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
# HARNESS_MODEL=deepseek-v4.1-flash
