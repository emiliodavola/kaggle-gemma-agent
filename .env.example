# Host-trial backend configuration. Copy to `.env` in the repo root and fill in.
# `.env` is git-ignored; NEVER commit real secrets. These variables drive the
# OFF-KAGGLE host trial only and are meaningless for the Kaggle submission
# (which is offline: no network, no API keys).

# API key for the OpenAI-compatible trial backend. Required.
OPENAI_API_KEY=sk-replace-me

# Base URL of the OpenAI-compatible trial backend.
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1

# opencode/Zen model id used by the trial backend. Trial-only.
HARNESS_MODEL=deepseek-v4.1-flash
